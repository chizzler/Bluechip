#!/bin/bash
# Usage: bt-details <mac>...
# Prints one JSON object keyed by lowercase MAC with the details Quickshell's
# BluetoothDevice doesn't expose: profile names and hardware ID (read from
# BlueZ over D-Bus), and battery published by an input driver (xpadneo,
# hid-playstation, ...) under /sys/class/power_supply rather than through
# BlueZ's Battery1.

set -u

# Driver batteries. The power_supply's HID parent records the Bluetooth MAC as
# HID_UNIQ, whatever the driver names the supply. One line per battery:
# mac, source, capacity, capacity_level, status (tab-separated).
batteries=""
for ps in /sys/class/power_supply/*; do
  [[ -r $ps/device/uevent ]] || continue
  mac=""
  while IFS='=' read -r key value; do
    [[ $key == HID_UNIQ ]] && mac=${value,,}
  done <"$ps/device/uevent"
  [[ -n $mac ]] || continue

  capacity="" level="" status=""
  [[ -r $ps/capacity ]] && read -r capacity <"$ps/capacity"
  [[ -r $ps/capacity_level ]] && read -r level <"$ps/capacity_level"
  [[ -r $ps/status ]] && read -r status <"$ps/status"
  batteries+="$mac"$'\t'"${ps##*/}"$'\t'"$capacity"$'\t'"$level"$'\t'"$status"$'\n'
done

objects=$(busctl --system --json=short call org.bluez / \
  org.freedesktop.DBus.ObjectManager GetManagedObjects 2>/dev/null) || objects='{"data":[{}]}'

jq -c --arg batteries "$batteries" '
  # Names for the common Bluetooth SIG 16-bit service UUIDs.
  def names: {
    "1101": "Serial Port", "1105": "Object Push", "1108": "Headset",
    "110a": "Audio Source", "110b": "Audio Sink",
    "110c": "Remote Control Target", "110e": "Remote Control",
    "110f": "Remote Control Controller", "1112": "Headset Gateway",
    "111e": "Hands-Free", "111f": "Hands-Free Gateway",
    "1124": "Human Interface Device", "112f": "Phonebook Access",
    "1132": "Message Access", "1200": "PnP Information",
    "1800": "Generic Access", "1801": "Generic Attribute",
    "180a": "Device Information", "180f": "Battery Service",
    "1812": "HID over GATT"
  };
  def profile:
    ascii_downcase
    | if test("^0000[0-9a-f]{4}-0000-1000-8000-00805f9b34fb$")
      then .[4:8] as $short | names[$short] // ("0x" + $short)
      else . end;

  ($batteries | split("\n") | map(select(. != "") | split("\t") | {
      key: .[0],
      value: {source: .[1], percent: (.[2] | if . == "" then null else tonumber end),
              level: .[3], status: .[4]}
    }) | from_entries) as $battery
  | ($ARGS.positional | map(ascii_downcase)) as $wanted
  | [ .data[0][] | .["org.bluez.Device1"] // empty
      | (.Address.data | ascii_downcase) as $mac
      | select(any($wanted[]; . == $mac))
      | ((.Modalias.data // "") | [capture("v(?<vid>[0-9A-Fa-f]{4})p(?<pid>[0-9A-Fa-f]{4})")] | .[0]) as $ids
      | {key: $mac, value: {
          profiles: [(.UUIDs.data // [])[] | profile],
          hardwareId: (if $ids then "\($ids.vid | ascii_upcase):\($ids.pid | ascii_upcase)" else "" end),
          battery: ($battery[$mac] // null)
        }}
    ]
  | from_entries
' --args "$@" <<<"$objects"
